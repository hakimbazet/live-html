# DeepSeek (OpenAI-compatible) — used for the one-shot HTML migration call.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# template + json output; raise if you see finish_reason=length truncation.
DEEPSEEK_MAX_TOKENS=32000

# Verify-screen fix assistant (multimodal chat — accepts screenshots).
# Use a vision-capable model here.
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_MAX_TOKENS=8000

# Optional cost accounting (USD per 1M tokens) for the recorded per-dashboard cost.
DEEPSEEK_COST_IN_PER_M=0.27
DEEPSEEK_COST_OUT_PER_M=1.1
